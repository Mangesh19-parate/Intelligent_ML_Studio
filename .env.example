# Intelligent ML Studio - Environment Configuration Template
PROJECT_NAME="ML Studio"
ENV=development
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=sqlite:///./apps/backend/ml_studio.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ml_studio

# Table Auto-Creation (Must be false in production; migrations handled via Alembic)
AUTO_CREATE_TABLES=true

# Security (Replace with cryptographically random key in production)
JWT_SECRET=dev-jwt-secret-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local Storage Directory
STORAGE_LOCAL_DIR=./apps/backend/data

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]
